---
import { allServices, site, u } from '../data/site';
import Icon from './Icon.astro';
---
<section id="hero" class="relative flex min-h-[calc(100dvh-3.5rem)] items-center overflow-hidden sm:min-h-dvh">
  <img src={u('/images/hero-background.webp')} alt={`Acoperiș cu tablă clic montat de ${site.name}`} width="1672" height="941" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
  <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_right,rgb(0_0_0/0.88)_0%,rgb(0_0_0/0.6)_45%,rgb(0_0_0/0.15)_100%)]"></div>
  <div aria-hidden="true" class="absolute inset-0 bg-black/35 sm:hidden"></div>
  <div aria-hidden="true" class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-bg"></div>

  <div class="site-container relative z-10 pt-[calc(var(--header-h)+1.500rem)] pb-28">
    <div class="max-w-xl lg:max-w-[52%]">
      <p class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/15 px-3 py-1 text-xs font-medium text-accent-bright">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M12 2 3 7v5c0 5.500 3.900 10.700 9 12 5.100-1.300 9-6.500 9-12V7l-9-5Z" /></svg>
        Servicii în {site.area}
      </p>
      <h1 class="font-heading text-[clamp(2.500rem,4.600vw,3.500rem)] leading-[1.08] font-bold tracking-tight">
        <span class="text-accent">Acoperișuri</span> și lucrări complete pentru <span class="text-accent">casa ta.</span>
      </h1>
      <p class="mt-5 text-[clamp(1.0625rem,1.600vw,1.375rem)] leading-relaxed text-muted">
        Montaj, reparații și renovări — acoperiș, exterior și interior, în {site.area}.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
        <a href={u('/contact/')} class="btn btn-primary w-full sm:w-auto">Solicită ofertă gratuită</a>
        <a href={u('/servicii/')} class="btn btn-outline w-full sm:w-auto">Descoperă serviciile</a>
      </div>
    </div>
  </div>

  <a href="#despre-noi" aria-label="Derulează în jos" class="absolute bottom-[60px] left-1/2 z-10 hidden h-11 w-11 -translate-x-1/2 items-center justify-center rounded-full text-muted transition-colors hover:text-text [@media(min-height:700px)]:flex">
    <Icon name="chevron" class="h-6 w-6" />
  </a>

  <div class="marquee absolute inset-x-0 bottom-0 z-10 border-t border-white/10 bg-bg/85 py-3 backdrop-blur-sm" style="--marquee-d: 90s">
    <ul class="marquee-track">
      {[0, 1].map((copy) => allServices.map((s) => (
        <li aria-hidden={copy === 1 ? 'true' : undefined} class="flex items-center text-sm font-medium whitespace-nowrap text-white/75 after:mx-4 after:h-3.5 after:w-px after:bg-white/25">{s}</li>
      )))}
    </ul>
  </div>
</section>
