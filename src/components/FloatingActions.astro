---
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<div class="fixed right-5 bottom-[72px] z-40 flex flex-col gap-3 sm:right-6 sm:bottom-6">
  <a href={`tel:${site.phoneHref}`} aria-label={`Sună la ${site.phone}`} class="flex h-14 w-14 items-center justify-center rounded-full bg-call text-white shadow-lg transition-transform hover:scale-105">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="M6.600 10.800a15.100 15.100 0 0 0 6.600 6.600l2.200-2.200a1 1 0 0 1 1-.250c1.100.370 2.300.570 3.600.570a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.500a1 1 0 0 1 1 1c0 1.250.200 2.450.570 3.570a1 1 0 0 1-.250 1l-2.220 2.230Z" /></svg>
  </a>
  <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="Scrie-ne pe WhatsApp" class="flex h-14 w-14 items-center justify-center rounded-full bg-call text-white shadow-lg transition-transform hover:scale-105">
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.600 15.100L2 22l5-1.300A10 10 0 1 0 12 2Zm0 1.800a8.200 8.200 0 1 1-4.200 15.250l-.300-.180-3 .790.800-2.900-.200-.300A8.200 8.200 0 0 1 12 3.800Zm-3.500 4.300c-.200 0-.500.070-.750.350-.260.280-1 .970-1 2.370 0 1.400 1 2.750 1.160 2.940.140.190 2 3.050 4.840 4.270 2.370 1 2.850.800 3.360.750.520-.050 1.670-.680 1.900-1.340.240-.660.240-1.220.170-1.340-.070-.120-.260-.190-.540-.330-.290-.140-1.680-.830-1.940-.920-.260-.100-.450-.140-.640.140-.190.280-.730.920-.900 1.110-.160.190-.330.210-.610.070-.290-.140-1.200-.440-2.290-1.410a8.600 8.600 0 0 1-1.580-1.970c-.170-.280-.020-.440.120-.580.130-.130.290-.330.430-.500.140-.160.190-.280.280-.470.100-.190.050-.350-.020-.500-.070-.140-.630-1.540-.870-2.110-.230-.550-.460-.480-.640-.490l-.540-.010Z" /></svg>
  </a>
</div>

<div class="fixed inset-x-0 bottom-0 z-40 flex h-14 border-t border-border bg-bg sm:hidden">
  <a href={`tel:${site.phoneHref}`} class="flex flex-1 items-center justify-center gap-2 text-sm font-semibold"><Icon name="phone" class="h-4 w-4" /> Sună Acum</a>
  <a href="#contact" class="flex flex-1 items-center justify-center gap-2 bg-accent text-sm font-semibold text-white"><Icon name="send" class="h-4 w-4" /> Cere Ofertă</a>
</div>
